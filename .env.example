PORT=3000

DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=postgres
DB_PORT=5432
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=30m

RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Worker and throughput tuning
PREFETCH_COUNT=10
PROCESSING_DELAY=0s
SCALER_INTERVAL=7s

# Per queue tuning, for example:
# EMAIL_HIGH_RPM=50
# EMAIL_HIGH_WORKERS=3
# EMAIL_HIGH_MAX_WORKERS=5
# SMS_HIGH_RPM=10
# PUSH_HIGH_WORKERS=3
