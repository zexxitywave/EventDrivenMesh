[Unit]
Description=Event-Driven Mesh - order-service
Documentation=https://github.com/zexxitywave/EventDrivenMesh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/order-service
EnvironmentFile=/etc/order-service.env

# JVM tuned for small EC2 instances; graceful shutdown drains in-flight requests
# (server.shutdown=graceful + spring.lifecycle.timeout-per-shutdown-phase=30s)
ExecStart=/usr/bin/java \
    -XX:+UseContainerSupport \
    -XX:MaxRAMPercentage=75.0 \
    -XX:+ExitOnOutOfMemoryError \
    -Djava.security.egd=file:/dev/./urandom \
    -jar /opt/order-service/order-service.jar

# SIGTERM -> graceful drain; 143 = normal JVM exit after SIGTERM
KillSignal=SIGTERM
SuccessExitStatus=143
TimeoutStopSec=45

Restart=on-failure
RestartSec=10

# Light hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
