# /etc/order-service.env  --  per-instance runtime config for order-service
# Copy to /etc/order-service.env on each EC2 instance and edit the values.
# Every instance runs the SAME jar; only INSTANCE_ID differs (or leave blank
# to auto-use the EC2 hostname, which is already unique per instance).

# ---- This instance ----------------------------------------------------------
# Leave blank to fall back to the EC2 hostname (unique per instance).
INSTANCE_ID=
SERVER_PORT=8081

# ---- Service discovery (Eureka) --------------------------------------------
# Private DNS / IP of the Eureka server reachable from this EC2 instance.
EUREKA_HOST=eureka.internal
EUREKA_PORT=8761

# ---- PostgreSQL -------------------------------------------------------------
# RDS endpoint or the EC2/private host running Postgres.
DB_HOST=order-db.internal
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me

# Per-instance pool. With N instances the total = N x DB_POOL_MAX; keep that
# under the Postgres/RDS max_connections budget (e.g. 3 instances x 5 = 15).
DB_POOL_MAX=5
DB_POOL_MIN=2

# ---- Kafka ------------------------------------------------------------------
# Comma-separated brokers. Consumers share group "order-service-group", so
# partitions are spread across instances (ensure topics have >= N partitions).
KAFKA_BOOTSTRAP_SERVERS=broker1.internal:9092,broker2.internal:9092

# ---- Optional ---------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=chaos-monkey
# JAVA_OPTS=-Xms256m -Xmx512m
