    {
      "name": "Product",
      "description": "Product catalog — CRUD, search, filters, pagination, categories",
      "item": [
        {
          "name": "Create Product",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('productId', json.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/products", "host": ["{{baseUrl}}"], "path": ["api","products"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Samsung Galaxy S25\",\n  \"description\": \"Latest flagship smartphone\",\n  \"price\": 79999.00,\n  \"sku\": \"SGS25-BLK-256\",\n  \"brand\": \"Samsung\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"stockQuantity\": 100,\n  \"imageUrls\": [\"https://example.com/image1.jpg\"]\n}"
            },
            "description": "Create a product. X-User-Id header is injected by the API Gateway from JWT — set it manually here for testing."
          }
        },
        {
          "name": "Bulk Create Products",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-User-Id", "value": "{{userId}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/products/bulk", "host": ["{{baseUrl}}"], "path": ["api","products","bulk"] },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"name\": \"iPhone 16\",\n    \"description\": \"Apple flagship\",\n    \"price\": 89999.00,\n    \"sku\": \"IPH16-BLK-128\",\n    \"brand\": \"Apple\",\n    \"categoryId\": \"{{categoryId}}\",\n    \"stockQuantity\": 50\n  },\n  {\n    \"name\": \"OnePlus 13\",\n    \"description\": \"OnePlus flagship\",\n    \"price\": 69999.00,\n    \"sku\": \"OP13-GRN-256\",\n    \"brand\": \"OnePlus\",\n    \"categoryId\": \"{{categoryId}}\",\n    \"stockQuantity\": 75\n  }\n]"
            },
            "description": "Bulk create multiple products in one request."
          }
        },
        {
          "name": "Get Product by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api","products","{{productId}}"] },
            "description": "Get product details by UUID."
          }
        },
        {
          "name": "Get Product by SKU",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/products/sku/SGS25-BLK-256", "host": ["{{baseUrl}}"], "path": ["api","products","sku","SGS25-BLK-256"] },
            "description": "Get product by SKU string."
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?keyword=samsung&minPrice=50000&maxPrice=100000&page=0&size=20&sortBy=price&sortDir=asc",
              "host": ["{{baseUrl}}"],
