            "description": "Returns total orders, total revenue, and average order value."
          }
        },
        {
          "name": "Get All Order Analytics",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/analytics/orders", "host": ["{{baseUrl}}"], "path": ["api","analytics","orders"] },
            "description": "Get all projected order analytics records from the analytics DB."
          }
        },
        {
          "name": "Get Top Customers",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/analytics/top-customers", "host": ["{{baseUrl}}"], "path": ["api","analytics","top-customers"] },
            "description": "Get customers ranked by total order count."
          }
        },
        {
          "name": "Get Revenue Per Day",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/analytics/revenue-per-day", "host": ["{{baseUrl}}"], "path": ["api","analytics","revenue-per-day"] },
            "description": "Get daily revenue time series data."
          }
