{
  "info": {
    "name": "EventDrivenMesh",
    "description": "Complete API collection for the EventDrivenMesh microservices project. All requests go through the API Gateway at http://localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "paymentId", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "categoryId", "value": "" },
    { "key": "inventoryId", "value": "" },
    { "key": "shipmentId", "value": "" },
    { "key": "notificationId", "value": "" },
    { "key": "logId", "value": "" },
    { "key": "alertRuleId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [

    {
      "name": "Auth",
      "description": "Authentication — register, verify, login, refresh, logout, password reset, OAuth2",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "description": "Register a new user. Sends OTP to the email for verification. No JWT required."
          }
        },
        {
          "name": "Verify Email (OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/verify-email", "host": ["{{baseUrl}}"], "path": ["api","auth","verify-email"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\"\n}"
            },
            "description": "Verify email using the 6-digit OTP sent after registration."
          }
        },
        {
          "name": "Resend Verification OTP",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/resend-verification?email=john@example.com",
              "host": ["{{baseUrl}}"],
              "path": ["api","auth","resend-verification"],
              "query": [{ "key": "email", "value": "john@example.com" }]
            },
            "description": "Resend verification OTP if user didn't receive it or it expired."
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "  pm.collectionVariables.set('userId', json.userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"password\": \"Password@123\"\n}"
            },
            "description": "Login with email + password. Auto-saves accessToken, refreshToken, and userId into collection variables."
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('accessToken', json.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.refreshToken);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","auth","refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Exchange refresh token for a new access token. Old refresh token is revoked (token rotation)."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api","auth","logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "description": "Revoke the refresh token. User will need to login again."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api","auth","forgot-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\"\n}"
            },
            "description": "Request a password reset OTP sent to the registered email."
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api","auth","reset-password"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword@123\"\n}"
            },
            "description": "Reset password using the OTP received via email."
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api","auth","me"] },
            "description": "Get current authenticated user info from JWT. Requires Bearer token."
          }
        },
        {
          "name": "Google OAuth2 Login (Browser)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/auth/oauth2/authorize/google", "host": ["{{baseUrl}}"], "path": ["api","auth","oauth2","authorize","google"] },
            "description": "Open this URL in a browser to start Google OAuth2 login flow."
          }
        }
      ]
    },

    {
      "name": "Order",
      "description": "Order management — place orders and trigger the Kafka saga",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.orderId) { pm.collectionVariables.set('orderId', json.orderId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api","orders"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{userId}}\",\n  \"items\": [\n    {\n      \"productId\": \"{{productId}}\",\n      \"productName\": \"Samsung Galaxy S25\",\n      \"quantity\": 1,\n      \"price\": 79999.00\n    }\n  ],\n  \"shippingAddress\": {\n    \"street\": \"123 MG Road\",\n    \"city\": \"Bangalore\",\n    \"state\": \"Karnataka\",\n    \"pincode\": \"560001\",\n    \"country\": \"India\"\n  },\n  \"totalAmount\": 79999.00\n}"
            },
            "description": "Place a new order. Triggers the full Kafka saga: order → inventory → payment → shipping → notification."
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api","orders","{{orderId}}"] },
            "description": "Get order details by order UUID."
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders", "host": ["{{baseUrl}}"], "path": ["api","orders"] },
            "description": "Get all orders (admin use)."
          }
        },
        {
          "name": "Get Orders by Customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/orders/customer/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","orders","customer","{{userId}}"] },
            "description": "Get all orders for a specific customer."
          }
        }
      ]
    },

    {
      "name": "Payment Gateway",
      "description": "Payment initiation, verification, refunds, and Razorpay webhook",
      "item": [
        {
          "name": "Initiate Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.paymentId) { pm.collectionVariables.set('paymentId', json.paymentId); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/payments/initiate", "host": ["{{baseUrl}}"], "path": ["api","payments","initiate"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"customerId\": \"{{userId}}\",\n  \"amount\": 79999.00,\n  \"currency\": \"INR\",\n  \"gateway\": \"RAZORPAY\"\n}"
            },
            "description": "Create a gateway order/session for the frontend checkout UI."
          }
        },
        {
          "name": "Verify Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/payments/verify", "host": ["{{baseUrl}}"], "path": ["api","payments","verify"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"gatewayOrderId\": \"order_xyz123\",\n  \"gatewayPaymentId\": \"pay_xyz123\",\n  \"gatewaySignature\": \"razorpay_signature_here\"\n}"
            },
            "description": "Verify Razorpay callback signature and capture the payment."
          }
        },
        {
          "name": "Refund Payment",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/payments/refund", "host": ["{{baseUrl}}"], "path": ["api","payments","refund"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentId\": \"{{paymentId}}\",\n  \"amount\": 79999.00,\n  \"reason\": \"Customer requested cancellation\"\n}"
            },
            "description": "Initiate a full or partial refund."
          }
        },
        {
          "name": "Get Payment by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/payments/{{paymentId}}", "host": ["{{baseUrl}}"], "path": ["api","payments","{{paymentId}}"] },
            "description": "Get payment details by payment UUID."
          }
        },
        {
          "name": "Get Payment by Order ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/payments/order/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api","payments","order","{{orderId}}"] },
            "description": "Get the payment associated with a specific order."
          }
        },
        {
          "name": "Get Payments by Customer",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/payments/customer/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api","payments","customer","{{userId}}"] },
            "description": "Get all payments made by a customer."
          }
        },
        {
          "name": "Get Order for Checkout (Proxy)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/payments/orders/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api","payments","orders","{{orderId}}"] },
            "description": "Proxy endpoint — fetches order details from order-service via Eureka for the checkout UI."
          }
        },
        {
          "name": "Razorpay Webhook",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Razorpay-Signature", "value": "razorpay_hmac_signature_here" }
            ],
            "url": { "raw": "{{baseUrl}}/api/payments/webhook/razorpay", "host": ["{{baseUrl}}"], "path": ["api","payments","webhook","razorpay"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.captured\",\n  \"payload\": {\n    \"payment\": {\n      \"entity\": {\n        \"id\": \"pay_xyz123\",\n        \"order_id\": \"order_xyz123\",\n        \"amount\": 7999900,\n        \"currency\": \"INR\",\n        \"status\": \"captured\"\n      }\n    }\n  }\n}"
            },
            "description": "Razorpay webhook endpoint. Called directly by Razorpay — no JWT needed. Secured via HMAC-SHA256 signature."
          }
        }
      ]
    },

    {
      "name": "Inventory",
      "description": "Inventory management — stock records, restock, availability check",
      "item": [
        {
          "name": "Create Inventory Item",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "if (json.id) { pm.collectionVariables.set('inventoryId', json.id); }"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/inventory", "host": ["{{baseUrl}}"], "path": ["api","inventory"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 100,\n  \"lowStockThreshold\": 10,\n  \"warehouseLocation\": \"Warehouse-A\"\n}"
            },
            "description": "Create an inventory record for a product."
          }
        },
        {
          "name": "Get Inventory by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/inventory/{{inventoryId}}", "host": ["{{baseUrl}}"], "path": ["api","inventory","{{inventoryId}}"] },
            "description": "Get inventory record by its UUID."
          }
        },
        {
          "name": "Get Inventory by Product ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/inventory/product/{{productId}}", "host": ["{{baseUrl}}"], "path": ["api","inventory","product","{{productId}}"] },
            "description": "Get inventory record by product UUID — most useful for other services."
          }
        },
        {
          "name": "Get All Inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/inventory", "host": ["{{baseUrl}}"], "path": ["api","inventory"] },
            "description": "List all inventory records."
          }
        },
        {
          "name": "Update Inventory Item",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/{{inventoryId}}", "host": ["{{baseUrl}}"], "path": ["api","inventory","{{inventoryId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 150,\n  \"lowStockThreshold\": 15,\n  \"warehouseLocation\": \"Warehouse-B\"\n}"
            },
            "description": "Update quantity, location, or threshold for an inventory record."
          }
        },
        {
          "name": "Restock Item",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/inventory/{{inventoryId}}/restock", "host": ["{{baseUrl}}"], "path": ["api","inventory","{{inventoryId}}","restock"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 50,\n  \"notes\": \"Restocked from supplier batch #42\"\n}"
            },
            "description": "Add units to an existing inventory record."
          }
        },
        {
          "name": "Delete Inventory Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/inventory/{{inventoryId}}", "host": ["{{baseUrl}}"], "path": ["api","inventory","{{inventoryId}}"] },
            "description": "Delete an inventory record."
          }
        },
        {
          "name": "Check Availability",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/inventory/check?productId={{productId}}&quantity=1",
              "host": ["{{baseUrl}}"],
              "path": ["api","inventory","check"],
              "query": [
                { "key": "productId", "value": "{{productId}}" },
                { "key": "quantity", "value": "1" }
              ]
            },
            "description": "Check if a product has sufficient stock. Returns true/false."
          }
        },
        {
          "name": "Get Low Stock Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/inventory/low-stock", "host": ["{{baseUrl}}"], "path": ["api","inventory","low-stock"] },
            "description": "Get all items currently in LOW_STOCK status."
          }
        }
      ]
    },

    {
      "name": "Shipping",
      "description": "Shipment tracking — auto-created when payment completes via Kafka",
      "item": [
        {
          "name": "Get Shipment by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/shipping/{{shipmentId}}", "host": ["{{baseUrl}}"], "path": ["api","shipping","{{shipmentId}}"] },
            "description": "Get shipment details by shipment UUID."
          }
        },
        {
          "name": "Get Shipment by Order ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/shipping/order/{{orderId}}", "host": ["{{baseUrl}}"], "path": ["api","shipping","order","{{orderId}}"] },
            "description": "Get the shipment associated with a specific order."
          }
        }
      ]
    },

