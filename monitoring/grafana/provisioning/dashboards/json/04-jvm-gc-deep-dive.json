{
  "uid": "zexxity-jvm-gc",
  "title": "Zexxity — JVM GC Deep Dive",
  "description": "Per-service GC analysis: pause times, allocation rate, heap pools, thread states, buffer pools",
  "tags": ["zexxity", "jvm", "gc"],
  "timezone": "browser",
  "refresh": "5s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 38,
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "datasource": { "uid": "prometheus" },
        "query": "label_values(jvm_memory_used_bytes{job=~\"order-service|inventory-service|payment-service|shipping-service\"}, job)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": { "text": "order-service", "value": "order-service" }
      }
    ]
  },
  "panels": [

    { "id": 1, "type": "row", "title": "GC Scorecards", "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 2, "type": "stat", "title": "GC Pause Time Avg",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "rate(jvm_gc_pause_seconds_sum{job=\"$service\"}[1m]) / rate(jvm_gc_pause_seconds_count{job=\"$service\"}[1m])", "legendFormat": "", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.2 }] } } }
    },

    {
      "id": 3, "type": "stat", "title": "GC Collections/min",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "rate(jvm_gc_pause_seconds_count{job=\"$service\"}[1m]) * 60", "legendFormat": "", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 10 }, { "color": "red", "value": 30 }] } } }
    },

    {
      "id": 4, "type": "stat", "title": "Heap Allocation Rate",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "rate(jvm_gc_memory_allocated_bytes_total{job=\"$service\"}[1m])", "legendFormat": "", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "Bps", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 5242880 }, { "color": "red", "value": 20971520 }] } } }
    },

    {
      "id": 5, "type": "stat", "title": "Memory Promoted to Old Gen/s",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "rate(jvm_gc_memory_promoted_bytes_total{job=\"$service\"}[1m])", "legendFormat": "", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "Bps", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1048576 }, { "color": "red", "value": 5242880 }] } } }
    },

    {
      "id": 6, "type": "gauge", "title": "Heap Used %",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{job=\"$service\", area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"$service\", area=\"heap\"}) * 100", "legendFormat": "", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] } } }
    },

    {
      "id": 7, "type": "stat", "title": "Metaspace Used",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "jvm_memory_used_bytes{job=\"$service\", id=\"Metaspace\"}", "legendFormat": "", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "bytes", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 134217728 }] } } }
    },

    { "id": 10, "type": "row", "title": "GC Pause Analysis", "gridPos": { "x": 0, "y": 5, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 11, "type": "timeseries", "title": "Pause Time by Action & Cause",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "rate(jvm_gc_pause_seconds_sum{job=\"$service\"}[1m])", "legendFormat": "{{action}} — {{cause}}", "refId": "A" }],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } }
    },

    {
      "id": 12, "type": "timeseries", "title": "GC Collections/min by Action",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "rate(jvm_gc_pause_seconds_count{job=\"$service\"}[1m]) * 60", "legendFormat": "{{action}} — {{cause}}", "refId": "A" }],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    },

    {
      "id": 13, "type": "timeseries", "title": "P99 Stop-the-World Pause",
      "gridPos": { "x": 0, "y": 14, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(jvm_gc_pause_seconds_bucket{job=\"$service\"}[5m])))", "legendFormat": "P99 STW Pause", "refId": "A" }],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 }, "color": { "mode": "fixed", "fixedColor": "red" } } }
    },

    {
      "id": 14, "type": "timeseries", "title": "P50 / P95 / P99 GC Pause Combined",
      "gridPos": { "x": 12, "y": 14, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(jvm_gc_pause_seconds_bucket{job=\"$service\"}[5m])))", "legendFormat": "P50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(jvm_gc_pause_seconds_bucket{job=\"$service\"}[5m])))", "legendFormat": "P95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(jvm_gc_pause_seconds_bucket{job=\"$service\"}[5m])))", "legendFormat": "P99", "refId": "C" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "lineWidth": 2 } } }
    },

    { "id": 20, "type": "row", "title": "Heap Memory", "gridPos": { "x": 0, "y": 22, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 21, "type": "timeseries", "title": "Heap Used vs Max",
      "gridPos": { "x": 0, "y": 23, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "sum(jvm_memory_used_bytes{job=\"$service\", area=\"heap\"})", "legendFormat": "Heap Used", "refId": "A" },
        { "expr": "sum(jvm_memory_max_bytes{job=\"$service\", area=\"heap\"})", "legendFormat": "Heap Max", "refId": "B" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Heap Max" }, "properties": [
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } },
            { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [10, 10] } }
          ]}
        ]
      }
    },

    {
      "id": 22, "type": "timeseries", "title": "Allocation Rate vs Promotion Rate",
      "gridPos": { "x": 12, "y": 23, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "rate(jvm_gc_memory_allocated_bytes_total{job=\"$service\"}[1m])", "legendFormat": "Allocation Rate", "refId": "A" },
        { "expr": "rate(jvm_gc_memory_promoted_bytes_total{job=\"$service\"}[1m])", "legendFormat": "Promotion Rate", "refId": "B" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Promotion Rate" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] }
        ]
      }
    },

    {
      "id": 23, "type": "timeseries", "title": "Heap Pool Breakdown",
      "gridPos": { "x": 0, "y": 31, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "jvm_memory_used_bytes{job=\"$service\", area=\"heap\"}", "legendFormat": "{{id}}", "refId": "A" }],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } }
    },

    {
      "id": 24, "type": "timeseries", "title": "Non-Heap: Metaspace & CodeCache",
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "jvm_memory_used_bytes{job=\"$service\", area=\"nonheap\"}", "legendFormat": "{{id}}", "refId": "A" }],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } }
    },

    { "id": 30, "type": "row", "title": "GC Correlation with Allocation", "gridPos": { "x": 0, "y": 39, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 31, "type": "timeseries", "title": "GC Pause vs Allocation Rate (dual axis)",
      "gridPos": { "x": 0, "y": 40, "w": 16, "h": 9 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "rate(jvm_gc_pause_seconds_sum{job=\"$service\"}[1m])", "legendFormat": "GC Pause Time/s", "refId": "A" },
        { "expr": "rate(jvm_gc_memory_allocated_bytes_total{job=\"$service\"}[1m])", "legendFormat": "Allocation Rate bytes/s", "refId": "B" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Allocation Rate bytes/s" }, "properties": [
            { "id": "unit", "value": "Bps" },
            { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } },
            { "id": "custom.axisPlacement", "value": "right" }
          ]}
        ]
      }
    },

    {
      "id": 32, "type": "gauge", "title": "Heap Used % (live)",
      "gridPos": { "x": 16, "y": 40, "w": 8, "h": 9 },
      "datasource": { "uid": "prometheus" },
      "targets": [{ "expr": "sum(jvm_memory_used_bytes{job=\"$service\", area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"$service\", area=\"heap\"}) * 100", "legendFormat": "", "refId": "A" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "showThresholdLabels": true, "showThresholdMarkers": true },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 85 }] } } }
    },

    { "id": 40, "type": "row", "title": "Threads & Buffer Pools", "gridPos": { "x": 0, "y": 49, "w": 24, "h": 1 }, "collapsed": false },

    {
      "id": 41, "type": "timeseries", "title": "Thread States",
      "gridPos": { "x": 0, "y": 50, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "jvm_threads_states_threads{job=\"$service\", state=\"runnable\"}", "legendFormat": "runnable", "refId": "A" },
        { "expr": "jvm_threads_states_threads{job=\"$service\", state=\"waiting\"}", "legendFormat": "waiting", "refId": "B" },
        { "expr": "jvm_threads_states_threads{job=\"$service\", state=\"timed-waiting\"}", "legendFormat": "timed-waiting", "refId": "C" },
        { "expr": "jvm_threads_states_threads{job=\"$service\", state=\"blocked\"}", "legendFormat": "blocked", "refId": "D" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "runnable" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byRegexp", "options": "waiting" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byRegexp", "options": "timed-waiting" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byRegexp", "options": "blocked" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      }
    },

    {
      "id": 42, "type": "timeseries", "title": "Live / Daemon / Peak Threads",
      "gridPos": { "x": 12, "y": 50, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "jvm_threads_live_threads{job=\"$service\"}", "legendFormat": "live", "refId": "A" },
        { "expr": "jvm_threads_daemon_threads{job=\"$service\"}", "legendFormat": "daemon", "refId": "B" },
        { "expr": "jvm_threads_peak_threads{job=\"$service\"}", "legendFormat": "peak", "refId": "C" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    },

    {
      "id": 43, "type": "timeseries", "title": "Direct & Mapped Buffer Pools",
      "gridPos": { "x": 0, "y": 58, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "jvm_buffer_memory_used_bytes{job=\"$service\"}", "legendFormat": "used — {{id}}", "refId": "A" },
        { "expr": "jvm_buffer_total_capacity_bytes{job=\"$service\"}", "legendFormat": "capacity — {{id}}", "refId": "B" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "lineWidth": 2 } } }
    },

    {
      "id": 44, "type": "timeseries", "title": "Classes Loaded / Unloaded per min",
      "gridPos": { "x": 12, "y": 58, "w": 12, "h": 8 },
      "datasource": { "uid": "prometheus" },
      "targets": [
        { "expr": "rate(jvm_classes_loaded_classes{job=\"$service\"}[1m]) * 60", "legendFormat": "loaded/min", "refId": "A" },
        { "expr": "rate(jvm_classes_unloaded_classes_total{job=\"$service\"}[1m]) * 60", "legendFormat": "unloaded/min", "refId": "B" }
      ],
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max", "lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "lineWidth": 2 } } }
    }

  ]
}
